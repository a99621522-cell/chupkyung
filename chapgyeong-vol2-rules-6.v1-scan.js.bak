// 六三. 여명(女命)의 자손이 흉사했다 (원문 254~257쪽 시각 판독)
// 여명 자손성 = 식신·상관. 추리: ① 식상이 백호대살에 임한 者
// ② 식상(지지)이 형·충을 맞은 者 (수태왕이면 익사 유형)
// ============================================================
function checkJasonHyungsa(saju, sex) {
  if (sex !== '여') return { 성립:false };
  const ilgan = saju.dStem;
  const 근거 = [];
  const rel = getRelations(saju);
  const pillars = [
    [saju.yStem, saju.yBranch], [saju.mStem, saju.mBranch],
    [saju.dStem, saju.dBranch], [saju.tStem, saju.tBranch],
  ];
  for (let i=0;i<4;i++) {
    const [st, br] = pillars[i];
    const stemIsSik = i!==2 && ['식신','상관'].includes(Y.getSipseong(ilgan, st));
    const jeonggi = (T.JIJANGGAN[br]||[]).slice(-1)[0];
    const brIsSik = ['식신','상관'].includes(Y.getSipseong(ilgan, jeonggi));
    if (!stemIsSik && !brIsSik) continue;
    if (BAEKHO_ILJU.includes(st+br)) 근거.push(`자손성(식상) 기둥(${st}${br})이 백호대살에 임함`);
    if (brIsSik && (rel.충.some(c=>c.includes(br)) || rel.형.some(h=>h.includes(br)))) 근거.push(`자손성(식상, ${br})이 형·충을 맞음`);
  }
  if (!근거.length) return { 성립:false };
  // 수태왕이면 익사 유형 부기
  const suCount = pillars.filter(([st,br],i)=> T.BRANCH_OHAENG[br]==='수' || (i!==2 && T.STEM_OHAENG[st]==='수')).length;
  const 결과 = suCount >= 3 ? '자손이 흉사하여 본다(수태왕 — 익사 유형)' : '자손이 흉사하여 본다';
  return { 성립:true, 근거:[...new Set(근거)], 결과 };
}
function topic63_jasonHyungsa(saju, sex) {
