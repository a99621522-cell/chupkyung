// ============================================================
// chapgyeong-vol2-rules-6.js — 2권 미구현 주제 보완 (원문 PDF 재판독 1차)
// 九. 다른 아버지 밥을 먹는다 (원문 28~33쪽)
// 추리: "一. 日坐財星이 他柱財와 聯合한 者" — 일지 재성이 타주 재와
// (육합 또는 저자 독창합으로) 연합. 저자독창합 4종 표는 원문 30~31쪽과
// 시각 대조로 일치 확인(준삼합·준방합·동합·우합=艮丑寅巽辰巳坤未申乾戌亥).
// ============================================================
const T = require('./chapgyeong-vol1-tables.js');
const B = require('./chapgyeong-vol1-basics.js');
const Y = require('./chapgyeong-vol1-yukchin.js');
const D = require('./chapgyeong-vol2-dokchang.js');

function getRelations(saju) {
  return B.checkBranchRelations([saju.yBranch, saju.mBranch, saju.dBranch, saju.tBranch]);
}

// 九. 다른 아버지 밥을 먹다 — 일지 재성이 다른 기둥 재와 (모든 합 종류로) 연합
function checkDareunAbeoji(saju) {
  const ilJaeJijanggan = (T.JIJANGGAN[saju.dBranch]||[]).filter(g => ['정재','편재'].includes(Y.getSipseong(saju.dStem,g)));
  if (!ilJaeJijanggan.length) return { 성립:false };

  const otherBranches = [saju.yBranch, saju.mBranch, saju.tBranch];
  const rel = getRelations(saju);
  for (const ob of otherBranches) {
    const obJaeJijanggan = (T.JIJANGGAN[ob]||[]).filter(g => ['정재','편재'].includes(Y.getSipseong(saju.dStem,g)));
    if (!obJaeJijanggan.length) continue;
    const yukhap = rel.합.some(h => h.includes(saju.dBranch) && h.includes(ob));
    const dokchang = D.checkJeojaDokchangHap(saju.dBranch, ob);
    if (yukhap || dokchang) {
      return { 성립:true, 근거: yukhap ? `일지 재성이 타주(${ob}) 재와 육합으로 연합` : `일지 재성이 타주(${ob}) 재와 ${dokchang}으로 연합`,
               결과: '다른 아버지의 밥을 먹어 본다(계부·이성 부친 인연)' };
    }
  }
  return { 성립:false };
}

// vol2 파이프라인 호환 래퍼
function topic09_dareunAbeoji(saju) {
  const r = checkDareunAbeoji(saju);
  return { 판정: r.성립, 근거: r.성립 ? [r.근거] : [], 결과: r.결과 || null };
}


// ============================================================
// 七. 어머니가 재가(再嫁)한다 (원문 25~26쪽 시각 판독)
// 추리: ① 인수(모)가 도화에 임함 ② 인수가 암합(타간과 천간합)함
// ============================================================
const STEM_HAP = { 갑기:1, 을경:1, 병신:1, 정임:1, 무계:1 };
function stemHap(a,b){ return !!STEM_HAP[[a,b].sort().join('')]; }

function getSamhapKey(branch) {
  for (const k of Object.keys(T.DOHWA)) if (k.includes(branch)) return k;
  return null;
}

function checkMochinJaega(saju) {
  const ilgan = saju.dStem;
  const stems = [saju.yStem, saju.mStem, saju.dStem, saju.tStem];
  const branches = [saju.yBranch, saju.mBranch, saju.dBranch, saju.tBranch];
  const 근거 = [];
  // 인수 위치 수집(천간 + 지지 정기)
  const inStemIdx = stems.map((st,i)=>i!==2 && ['정인','편인'].includes(Y.getSipseong(ilgan,st)) ? i : -1).filter(i=>i>=0);
  const inBranchIdx = branches.map((b,i)=>{
    const jeonggi = (T.JIJANGGAN[b]||[]).slice(-1)[0];
    return ['정인','편인'].includes(Y.getSipseong(ilgan,jeonggi)) ? i : -1;
  }).filter(i=>i>=0);
  if (!inStemIdx.length && !inBranchIdx.length) return { 성립:false };
  // ① 인수 지지가 도화(년지 삼합 기준)에 임함
  const yearKey = getSamhapKey(saju.yBranch);
  if (yearKey) {
    const dohwaBranch = T.DOHWA[yearKey];
    if (inBranchIdx.some(i => branches[i] === dohwaBranch)) 근거.push('인수(모)가 도화에 임함');
  }
  // ② 인수 천간이 타 천간과 암합(천간합)
  for (const i of inStemIdx) {
    for (let j=0;j<4;j++) {
      if (j===i) continue;
      if (stemHap(stems[i], stems[j])) { 근거.push(`인수(${stems[i]})가 ${stems[j]}와 암합`); break; }
    }
    if (근거.length >= 2) break;
  }
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거, 결과:'모친이 재가(再嫁)하여 본다' };
}
function topic07_mochinJaega(saju) {
  const r = checkMochinJaega(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}

// ============================================================
// 八. 다른(여러) 어머니를 모셔 본다 (원문 27~28쪽 시각 판독)
// 추리: ① 多逢印綬者(인수를 많이 만남) ② 인수가 재(부)와 암합한 자
// ============================================================
function checkYeoreoEomeoni(saju) {
  const ilgan = saju.dStem;
  const stems = [saju.yStem, saju.mStem, saju.dStem, saju.tStem];
  const 근거 = [];
  const G1 = require('./chapgyeong-vol4-gyeokguk.js');
  const inCount = G1.countSipseongAll(saju, ['정인','편인']).count;
  if (inCount >= 3) 근거.push(`인수를 많이 만남(多逢印綬, ${inCount}개)`);
  // 인수 천간이 재 천간과 암합
  for (let i=0;i<4;i++) {
    if (i===2) continue;
    if (!['정인','편인'].includes(Y.getSipseong(ilgan, stems[i]))) continue;
    for (let j=0;j<4;j++) {
      if (j===2 || j===i) continue;
      if (['정재','편재'].includes(Y.getSipseong(ilgan, stems[j])) && stemHap(stems[i], stems[j])) {
        근거.push(`인수(모, ${stems[i]})가 재(부, ${stems[j]})와 암합`); break;
      }
    }
  }
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거, 결과:'다른(여러) 어머니를 모셔 본다(서모·계모 인연)' };
}
function topic08_yeoreoEomeoni(saju) {
  const r = checkYeoreoEomeoni(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}


// ============================================================
// 二. 선조 제사에 무성의(先祖奉祀 無誠意)하다 (원문 13쪽 시각 판독)
// 추리: ① 年月이 冲·刑한 者 ② (年이) 空亡한 者
// (년=선조 자리가 충·형·공망으로 손상되면 조상 받듦에 성의 없음)
// ============================================================
const G60 = require('./chapgyeong-vol1-gapja60.js');
function getGongmangOfIlju(saju) {
  const sun = G60.getSunInfo(saju.dStem + saju.dBranch);
  if (!sun) return [];
  return T.GONGMANG[sun.순 + '순'] || [];
}
function checkSeonjoBongsa(saju) {
  const 근거 = [];
  const rel = getRelations(saju);
  const yb = saju.yBranch, mb = saju.mBranch;
  if (rel.충.some(c => c.includes(yb) && c.includes(mb))) 근거.push('년월이 상충(선조 자리 손상)');
  if (rel.형.some(h => h.includes(yb) && h.includes(mb))) 근거.push('년월이 상형');
  const gm = getGongmangOfIlju(saju);
  if (gm.includes(yb)) 근거.push('년지가 공망(선조 자리 비어 있음)');
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거, 결과:'선조 제사(봉사)에 무성의하다' };
}
function topic02_seonjoBongsa(saju) {
  const r = checkSeonjoBongsa(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}


// ============================================================
// 一一. 외삼촌·처남이 고독하다 (원문 34~37쪽 시각 판독)
// 실례 판정 공통 조건: 외숙성(인수 계열)·처남성(재 계열)이 앉은 자리가
// 형·충을 맞거나 백호대살에 임한 者
// ============================================================
const BAEKHO_ILJU = ['갑진','을미','병술','정축','무진','임술','계축'];
function checkOesukCheonam(saju) {
  const ilgan = saju.dStem;
  const pillars = [
    [saju.yStem, saju.yBranch], [saju.mStem, saju.mBranch],
    [saju.dStem, saju.dBranch], [saju.tStem, saju.tBranch],
  ];
  const rel = getRelations(saju);
  const 근거 = [];
  for (let i=0;i<4;i++) {
    const [st, br] = pillars[i];
    const stemSip = i!==2 ? Y.getSipseong(ilgan, st) : null;
    const jeonggi = (T.JIJANGGAN[br]||[]).slice(-1)[0];
    const brSip = Y.getSipseong(ilgan, jeonggi);
    const isTarget = ['정재','편재','정인','편인'].includes(stemSip) || ['정재','편재','정인','편인'].includes(brSip);
    if (!isTarget) continue;
    const 육친 = ['정재','편재'].includes(stemSip)||['정재','편재'].includes(brSip) ? '처남성(재)' : '외숙성(인수)';
    const hyeongchung = rel.충.some(c=>c.includes(br)) || rel.형.some(h=>h.includes(br));
    if (hyeongchung) { 근거.push(`${육친}이 형·충을 맞음`); }
    if (BAEKHO_ILJU.includes(st+br)) { 근거.push(`${육친} 기둥(${st}${br})이 백호대살`); }
  }
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거:[...new Set(근거)], 결과:'외삼촌·처남이 고독하다' };
}
function topic11_oesukCheonam(saju) {
  const r = checkOesukCheonam(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}


// ============================================================
// 一二. 조모 또는 장모 두 분을 모셔 본다 (원문 36~37쪽 시각 판독)
// 추리: 편인·식신을 多逢한 者 (조모·장모성이 거듭 나타남 — 포함적 조건이므로 지장간 전체 기준)
// ============================================================
function checkJomoJangmo(saju) {
  const G1 = require('./chapgyeong-vol4-gyeokguk.js');
  // [원문 37쪽 조건] 상관·식신을 많이 만난 자 (합본 확인: 편인 아님 → 상관·식신)
  const sikCount = G1.countSipseongAll(saju, ['식신','상관']).count;
  const 근거 = [];
  if (sikCount >= 4) 근거.push(`상관·식신 다봉(${sikCount}개)`);
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거, 결과:'조모 또는 장모 두 분을 모셔 본다' };
}
function topic12_jomoJangmo(saju) {
  const r = checkJomoJangmo(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}


// ============================================================
// 一三. 장모를 봉양하여 본다 (원문 38~41쪽 시각 판독)
// 장모성 = 식신·상관(처=재를 낳는 별). 추리:
// ① 일지(처궁)에 식상을 놓고 타주에 재(처)가 있는 者
// ② 타주의 식상이 일지와 합한 者
// ============================================================
function checkJangmoBongyang(saju) {
  const ilgan = saju.dStem;
  const 근거 = [];
  const rel = getRelations(saju);
  const branches = [saju.yBranch, saju.mBranch, saju.dBranch, saju.tBranch];
  const stems = [saju.yStem, saju.mStem, saju.dStem, saju.tStem];
  const ilSikJijang = (T.JIJANGGAN[saju.dBranch]||[]).some(g => ['식신','상관'].includes(Y.getSipseong(ilgan,g)));
  const hasJaeOther = [0,1,3].some(i =>
    ['정재','편재'].includes(Y.getSipseong(ilgan, stems[i])) ||
    (T.JIJANGGAN[branches[i]]||[]).some(g => ['정재','편재'].includes(Y.getSipseong(ilgan,g))));
  if (ilSikJijang && hasJaeOther) 근거.push('일지(처궁)에 식상(장모성)을 놓고 타주에 재(처)가 있음');
  // ② 타주 식상 지지가 일지와 합
  for (const i of [0,1,3]) {
    const jeonggi = (T.JIJANGGAN[branches[i]]||[]).slice(-1)[0];
    if (!['식신','상관'].includes(Y.getSipseong(ilgan, jeonggi))) continue;
    if (rel.합.some(h => h.includes(branches[i]) && h.includes(saju.dBranch))) {
      근거.push(`타주 식상(${branches[i]})이 일지와 합함`); break;
    }
  }
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거:[...new Set(근거)], 결과:'장모를 봉양하여 본다' };
}
function topic13_jangmoBongyang(saju) {
  const r = checkJangmoBongyang(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}


// ============================================================
// 一四. 이복형제(자매)가 있다 (원문 42~45쪽 시각 판독)
// 추리: ① 일지가 비겁(형제성) 지지와 합·형을 이루는 者
//        ② 일간이 타간과 합화하여 그 화기(化氣)가 비겁이 되는 者
// ============================================================
const STEM_HAP_HWA_14 = { 갑기:'토', 을경:'금', 병신:'수', 정임:'목', 무계:'화' };
function checkIbokHyeongje(saju) {
  const ilgan = saju.dStem;
  const ilOh = Y.ohaengOf(ilgan);
  const 근거 = [];
  const rel = getRelations(saju);
  const branches = [saju.yBranch, saju.mBranch, saju.dBranch, saju.tBranch];
  const stems = [saju.yStem, saju.mStem, saju.dStem, saju.tStem];
  // ① 일지-타지 합/형인데 그 타지 정기가 비겁
  for (const i of [0,1,3]) {
    const jeonggi = (T.JIJANGGAN[branches[i]]||[]).slice(-1)[0];
    if (!['비견','비겁','겁재'].includes(Y.getSipseong(ilgan, jeonggi))) continue;
    const hap = rel.합.some(h => h.includes(saju.dBranch) && h.includes(branches[i]));
    const hyeong = rel.형.some(h => h.includes(saju.dBranch) && h.includes(branches[i]));
    if (hap || hyeong) { 근거.push(`일지가 비겁(${branches[i]})과 ${hap?'합':'형'}을 이룸`); break; }
  }
  // ② 일간 합화 → 화기가 비겁 오행
  for (const i of [0,1,3]) {
    const key = [ilgan, stems[i]].sort().join('');
    const hwa = STEM_HAP_HWA_14[key];
    if (hwa && hwa === ilOh) { 근거.push(`일간이 ${stems[i]}와 합화(${hwa}) — 화기가 비겁이 됨`); break; }
  }
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거, 결과:'이복형제(자매)가 있다' };
}
function topic14_ibokHyeongje(saju) {
  const r = checkIbokHyeongje(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}


// ============================================================
// 一五. 고부간(姑婦間)에 불화한다 (원문 45~48쪽 시각 판독)
// 실례 공통: 재(처)와 인수(모)가 서로 충·형하거나, 한쪽이 왕성해 상대를 극함
// ============================================================
function checkGobuBulhwa(saju) {
  // [원문 45쪽 조건] ① 인수 약·재 다, 또는 재 약·인수 왕 ② 일월지가 충·원진, 또는 재와 인이 제화 없이 쟁투
  const ilgan = saju.dStem;
  const 근거 = [];
  const rel = getRelations(saju);
  const G1 = require('./chapgyeong-vol4-gyeokguk.js');
  const jaeCount = G1.countSipseongAll(saju, ['정재','편재']).count;
  const inCount = G1.countSipseongAll(saju, ['정인','편인']).count;
  if (jaeCount >= 3 && inCount >= 1 && inCount <= 1) 근거.push(`인수 약(${inCount})·재 다(${jaeCount})`);
  if (inCount >= 3 && jaeCount >= 1 && jaeCount <= 1) 근거.push(`재 약(${jaeCount})·인수 왕(${inCount})`);
  if (jaeCount >= 1 && inCount >= 1) {
    const pair = [saju.mBranch, saju.dBranch];
    const r2 = B.checkBranchRelations(pair);
    if (r2.충.length) 근거.push('일월지 상충(재·인 쟁투)');
    if (r2.원진 && r2.원진.length) 근거.push('일월지 원진(재·인 쟁투)');
  }
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거:[...new Set(근거)], 결과:'고부간에 정이 없다(불화)' };
}
function topic15_gobuBulhwa(saju) {
  const r = checkGobuBulhwa(saju);
  return { 판정: r.성립, 근거: r.근거||[], 결과: r.결과||null };
}


// ============================================================
// 一六. 시모간(媤母間)에 불화한다 — 여명 기준 (원문 48~50쪽 시각 판독)
// 시모성 = 재(남편 관을 낳는 별). 추리: ① 비견·비겁 太旺한 者(비겁이
// 재=시모를 극) ② 인수 太旺한 者(재극인 — 시모와 전투)
// ============================================================
function checkSimoBulhwa(saju, sex) {
  if (sex !== '여') return { 성립:false };
  const G1 = require('./chapgyeong-vol4-gyeokguk.js');
  const jaeCount = G1.countSipseongAll(saju, ['정재','편재']).count;
