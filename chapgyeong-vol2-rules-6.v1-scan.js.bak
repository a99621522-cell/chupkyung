  else if (gwansalCount <= 1) 근거.push('관성 미약(1점) — 왕한 상관에 파극됨');
  else return { 성립:false }; // 관이 든든하면 불성립
  return { 성립:true, 근거, 결과:'기생(접객) 생활의 직업을 갖는다' };
