// ============================================================
const GACHUL_ILJU = ['을사','신사','계사','정해','기해'];
function checkGachul(saju) {
  const ilju = saju.dStem + saju.dBranch;
  const iljiSaHae = ['사','해'].includes(saju.dBranch);
  if (!iljiSaHae) return { 성립:false };
  const rel = getRelations(saju);
  const chung = rel.충.some(c => c.includes(saju.dBranch));
  if (!chung) return { 성립:false };
  const 근거 = [`일지 ${saju.dBranch}(역마성)가 충을 맞음 — 역마 충동`];
  if (GACHUL_ILJU.includes(ilju)) 근거.unshift(`${ilju}일생(원문 명시 일주)`);
  return { 성립:true, 근거, 결과:'집에 들어오지 않는(가출·원행하는) 식구가 있다' };
}
