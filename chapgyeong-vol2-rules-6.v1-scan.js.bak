// ============================================================
// 三八. 음식물업(飮食物業)을 하여 본다 (원문 152~155쪽 시각 판독)
// 해설 핵심: 식신·상관(먹을 것)이 재를 생하는 구조(식상생재) —
// 식신으로 재물을 만드는 업. 같은 기둥 안에서 천간(식상)→지지(재)
// 직접 생이면 더욱 확실(살인상생 v25와 같은 "같은 기둥" 원리).
// ============================================================
function checkEumsikmulEop(saju) {
  // [원문 153쪽 조건] ① 임신·임자·임진·경신·경자·경진일 ② 무신·무자일 상관생재/수재국, 기축·기묘일 재살국
  // ③ 병신·병자·병진일 재살왕, 임계일 식신국·재국 ④ 일진 불문 상관생재·식신생재"격"을 이룬 자(월지 식상격+재 투출)
  const G1 = require('./chapgyeong-vol4-gyeokguk.js');
  const ilgan = saju.dStem, ilju = saju.dStem + saju.dBranch;
  const branches = [saju.yBranch, saju.mBranch, saju.dBranch, saju.tBranch];
  const stems = [saju.yStem, saju.mStem, saju.tStem];
  const 근거 = [];
  const GEUK = { 목:'토', 화:'금', 토:'수', 금:'목', 수:'화' };
  const GEUKBY = { 목:'금', 화:'수', 토:'목', 금:'화', 수:'토' };
  const SAENG = { 목:'화', 화:'토', 토:'금', 금:'수', 수:'목' };
  const ilOh = Y.ohaengOf(ilgan);
  const guks = [...B.checkSamhap(branches), ...B.checkBanghap(branches)].map(g=>g.ohaeng);
  const jaeCount = G1.countSipseongAll(saju, ['정재','편재']).count;
  const salCount = G1.countSipseongAll(saju, ['정관','편관']).count;
  const sikTuchul = stems.some(st => ['식신','상관'].includes(Y.getSipseong(ilgan, st)));
  const jaeTuchul = stems.some(st => ['정재','편재'].includes(Y.getSipseong(ilgan, st)));
  if (['임신','임자','임진','경신','경자','경진'].includes(ilju)) 근거.push(`${ilju}일생(조건①)`);
  if (['무신','무자'].includes(ilju) && ((sikTuchul && jaeTuchul) || guks.includes('수'))) 근거.push(`${ilju}일 상관생재/수재국(조건②)`);
  if (['기축','기묘'].includes(ilju) && (guks.includes(GEUK[ilOh]) || guks.includes(GEUKBY[ilOh]))) 근거.push(`${ilju}일 재·살국(조건②)`);
  if (['병신','병자','병진'].includes(ilju) && jaeCount + salCount >= 4) 근거.push(`${ilju}일 재살왕(조건③)`);
  if (['임','계'].includes(ilgan) && (guks.includes(SAENG[ilOh]) || guks.includes(GEUK[ilOh]))) 근거.push('임계일 식신국·재국(조건③)');
  const woljiJeonggi = (T.JIJANGGAN[saju.mBranch]||[]).slice(-1)[0];
  if (['식신','상관'].includes(Y.getSipseong(ilgan, woljiJeonggi)) && jaeTuchul) 근거.push('식상격에 재 투출 — 식상생재격(조건④)');
  if (!근거.length) return { 성립:false };
  return { 성립:true, 근거, 결과:'음식물업(여관·요리·다방·양조 등)을 하여 본다' };
}
